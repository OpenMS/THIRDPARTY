# Sources of the engines that this repository rebuilds (see README.md).
# Read by the scripts in this folder and by .github/workflows/rebuild-engines.yml.

# zlib and expat that replace the copies the engines bundle
ZLIB_VERSION=1.3.2
ZLIB_URL=https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.gz
ZLIB_SHA256=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16
EXPAT_VERSION=2.8.5
EXPAT_URL=https://github.com/libexpat/libexpat/releases/download/R_2_8_5/expat-2.8.5.tar.xz
EXPAT_SHA256=1e727b8933ec51a77a9a9d9afcf8e688bce45d907c13e36ab7393fe36e703182

# Comet 2025.01 rev. 1: its MSToolkit bundles zlib 1.2.11 and expat 2.2.9
COMET_REPO=https://github.com/UWPR/Comet.git
COMET_TAG=v2025.01.1
COMET_COMMIT=4181df6987a4b997dfded79b07f154682ff7838d

# MaRaCluster 1.04.1: links ProteoWizard, which bundles zlib 1.2.3
MARACLUSTER_REPO=https://github.com/statisticalbiotechnology/maracluster.git
MARACLUSTER_TAG=rel-1-04-1
MARACLUSTER_COMMIT=c122929692d731766385a5fce36acbfab17b807a

# ProteoWizard as the rel-1-04-1 release build used it: that build (26 June 2025)
# took the newest ProteoWizard source from TeamCity, which was master at this commit.
PWIZ_REPO=https://github.com/ProteoWizard/pwiz.git
PWIZ_COMMIT=9ba731735533a808ad9b983a6789af31b9971bcd

# Verification (compare/): the rebuilt engines must give the same results as the
# upstream-built binaries that this repository held before (THIRDPARTY at this
# commit), on this OpenMS revision's test data.
BASELINE_COMMIT=fd8c89f407c1ecae9328ec71bb452195a7799641
OPENMS_REPO=https://github.com/OpenMS/OpenMS.git
OPENMS_TESTDATA_COMMIT=0baa9a5594314910eea65dcaf555cc6f59517a97
