diff --git a/admin/builders/install_proteowizard.sh b/admin/builders/install_proteowizard.sh
index 0bc2823..338bcd7 100755
--- a/admin/builders/install_proteowizard.sh
+++ b/admin/builders/install_proteowizard.sh
@@ -3,6 +3,8 @@ tools_dir=$1
 # change directory to the <build_dir>/tools directory
 cd ${tools_dir}
 
+# OpenMS THIRDPARTY: build the ProteoWizard source tree in proteowizard/ if there is one
+if [ ! -d proteowizard ]; then
 echo "Download source code for ProteoWizard from their TeamCity server"
 wget --no-check-certificate --no-verbose -O bt81.xml https://proteowizard.sourceforge.io/releases/bt81.xml
 # without-tv: without tests and vendor reader
@@ -15,6 +17,7 @@ if [ ! -f ${tools_dir}/${FILE_NAME} ]; then
   mkdir proteowizard
   tar xf ${FILE_NAME} --directory proteowizard  
 fi
+fi
 
 cd proteowizard
 
@@ -25,7 +28,8 @@ echo "Building ProteoWizard and Boost, this may take some time.."
 
 # if you have more than 4GB of memory available, you could try to use more than 2 cores to speed things up
 # add -d2 flag to get verbose output with compiler and linker commands
-./quickbuild.sh ${toolset} -j2 --prefix=../ \
+# OpenMS THIRDPARTY: zlib 1.3.2 in place of ProteoWizard's zlib 1.2.3, for ProteoWizard, Boost and MaRaCluster
+./quickbuild.sh ${toolset} -j2 --prefix=../ --zlib-src="$(pwd)/libraries/zlib-1.3.2" \
                 pwiz/data/common//pwiz_data_common \
                 pwiz/data/identdata//pwiz_data_identdata \
                 pwiz/data/identdata//pwiz_data_identdata_version \
@@ -67,7 +71,7 @@ echo "Updating Proteowizard and Boost libraries and include files."
 find build-*/ -type f | grep -i libboost_regex-.*\.a$ | xargs -I{} cp {} ../lib
 find build-*/ -type f | grep -i libboost_program_options-.*\.a$ | xargs -I{} cp {} ../lib
 
-rsync -ap --include "*/" --include "*.h" --include "*.hpp" --exclude "*"  libraries/zlib-1.2.3/ ../include
+rsync -ap --include "*/" --include "*.h" --include "*.hpp" --exclude "*"  libraries/zlib-1.3.2/ ../include
 rsync -ap --include "*/" --include "*.h" --include "*.hpp" --exclude "*" libraries/boost_aux/boost/ ../include/boost
 rsync -ap --include "*/" --include '*.ipp' --exclude '*' libraries/boost_1_86_0/boost/ ../include/boost
 
