diff --git a/admin/builders/_urls_and_file_names_.bat b/admin/builders/_urls_and_file_names_.bat
index d014e13..42dc035 100644
--- a/admin/builders/_urls_and_file_names_.bat
+++ b/admin/builders/_urls_and_file_names_.bat
@@ -23,7 +23,8 @@ set PWIZ_URL=https://mc-tca-01.s3.us-west-2.amazonaws.com/ProteoWizard/bt81/%PWI
 
 ::: remember to update the boost and zlib version when ProteoWizard updates their versions
 set BOOST_BASE=boost_1_86_0
-set ZLIB_BASE=zlib-1.2.3
